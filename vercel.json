      "destination": "https://hasan-portfolio-game.vercel.app/_next/:path*"
    },
    {
      "source": "/hasan-mahmud-profile.png",
      "destination": "https://hasan-portfolio-game.vercel.app/hasan-mahmud-profile.png"
    }
  ]
}